CAPI=2:

name: openhwgroup.org:tb:udma_subsystem:0
description: Focused camera-free uDMA subsystem regression

filesets:
  rtl:
    depend:
      - pulp-platform.org::common_cells
      - openhwgroup.org:ip:logint_dc_fifo_xbar
      - openhwgroup.org:ip:udma_core
      - openhwgroup.org:ip:udma_uart
      - openhwgroup.org:ip:udma_qspi
      - openhwgroup.org:ip:udma_i2c
      - openhwgroup.org:ip:udma_i2s
      - openhwgroup.org:ip:udma_sdio
      - openhwgroup.org:ip:udma_filter
      - openhwgroup.org:ip:udma_external_per
    files:
      - rtl/includes/pulp_soc_defines.svh:
          is_include_file: true
          include_path: rtl/includes
      - rtl/includes/pulp_peripheral_defines.svh:
          is_include_file: true
          include_path: rtl/includes
      - rtl/vendor/pulp_platform_tech_cells_generic/src/rtl/tc_clk.sv
      - rtl/vendor/pulp_platform_tech_cells_generic/src/deprecated/pulp_clk_cells.sv
      - rtl/vendor/pulp_platform_tech_cells_generic/src/deprecated/pulp_clock_gating_async.sv
      - rtl/core-v-mcu/udma_subsystem/udma_subsystem.sv
    file_type: systemVerilogSource

  tb_smoke:
    files:
      - tests/rtl/udma_subsystem/udma_subsystem_smoke_tb.sv
    file_type: systemVerilogSource

  tb_uart_tx:
    files:
      - tests/rtl/udma_subsystem/udma_subsystem_uart_tx_tb.sv
    file_type: systemVerilogSource

  tb_uart_rx:
    files:
      - tests/rtl/udma_subsystem/udma_subsystem_uart_rx_tb.sv
    file_type: systemVerilogSource

targets:
  lint:
    default_tool: verilator
    filesets:
      - rtl
    toplevel:
      - udma_subsystem
    tools:
      verilator:
        mode: lint-only
        verilator_options:
          - -Wno-fatal
          - --timing

  sim:
    description: Run the camera-free uDMA reset and configuration smoke test
    default_tool: verilator
    filesets:
      - rtl
      - tb_smoke
    toplevel:
      - udma_subsystem_smoke_tb
    tools:
      verilator:
        mode: binary
        verilator_options:
          - -Wno-fatal
          - --timing
          - --trace

  sim_uart_tx:
    description: Exercise APB configuration and one UART0 TX DMA transfer
    default_tool: verilator
    filesets:
      - rtl
      - tb_uart_tx
    toplevel:
      - udma_subsystem_uart_tx_tb
    tools:
      verilator:
        mode: binary
        verilator_options:
          - -Wno-fatal
          - --timing
          - --trace

  sim_uart_rx:
    description: Exercise APB configuration and one UART0 RX DMA transfer
    default_tool: verilator
    filesets:
      - rtl
      - tb_uart_rx
    toplevel:
      - udma_subsystem_uart_rx_tb
    tools:
      verilator:
        mode: binary
        verilator_options:
          - -Wno-fatal
          - --timing
          - --trace
